      { id: "A13", tier: "advanced", topic: "PASS e FAIL", q: "Um teste falhou depois de uma alteração. Qual atitude é mais adequada?", a: ["Ler Expected e Received e investigar função e expectativa", "Apagar o teste", "Trocar FAIL por PASS no texto"], correct: 0, note: "A mensagem de falha orienta a investigação do código e do próprio teste." },
      { id: "A14", tier: "advanced", topic: "Executando", q: "Você está corrigindo somente saudacao.test.js. Qual comando evita executar os outros arquivos?", a: ["npx jest saudacao.test.js", "npm test soma.js saudacao.js", "node --all"], correct: 0, note: "Passar o caminho do arquivo concentra a execução naquele teste." }
    ];

    const STORAGE_KEY = "corridaJestCooperativa.v1";
    const topics = ["Preparação", "Função JavaScript", "Arquivo de teste", "Executando", "PASS e FAIL", "Novos usos"];
    const $ = (id) => document.getElementById(id);
    let state = freshState();

    function freshState() {
      return {
        team: "", players: ["", ""], className: "", currentPlayer: 0,
        position: 0, round: 1, currentQuestionId: null,
        answerOrder: null,
        used: { easy: [], medium: [], advanced: [] },
        history: [], answersLog: [], phase: "question", finished: false,
        startedAt: null
      };
    }

    function save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    function load() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (saved && saved.team && Array.isArray(saved.players)) {
          state = { ...freshState(), ...saved, used: { ...freshState().used, ...(saved.used || {}) } };
        }
      } catch (_) { localStorage.removeItem(STORAGE_KEY); }
    }

    function tierForPosition(position) {
      if (position < 10) return "easy";
      if (position < 20) return "medium";
      return "advanced";
    }

    function topicIndexForPosition(position) {
      if (position >= 26) return 5;
      if (position >= 21) return 4;
      if (position >= 16) return 3;
      if (position >= 11) return 2;
      if (position >= 6) return 1;
      return 0;
    }

    function randomInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function chooseQuestion() {
      const tier = tierForPosition(state.position);
      let candidates = questionBank.filter((item) => item.tier === tier && !state.used[tier].includes(item.id));
      if (!candidates.length) {
        state.used[tier] = [];
        candidates = questionBank.filter((item) => item.tier === tier);
      }
      const item = candidates[randomInt(0, candidates.length - 1)];
      state.used[tier].push(item.id);
      state.currentQuestionId = item.id;
      state.answerOrder = shuffledIndexes(item.a.length);
      state.phase = "question";
      save();
      return item;
    }

    function shuffledIndexes(length) {
      const indexes = Array.from({ length }, (_, index) => index);
      for (let i = indexes.length - 1; i > 0; i -= 1) {
        const j = randomInt(0, i);
        [indexes[i], indexes[j]] = [indexes[j], indexes[i]];
      }
      return indexes;
    }

    function answerOrderFor(item) {
      const valid = Array.isArray(state.answerOrder)
        && state.answerOrder.length === item.a.length
        && new Set(state.answerOrder).size === item.a.length;
      if (!valid) {
        state.answerOrder = shuffledIndexes(item.a.length);
        save();
      }
      return state.answerOrder;
    }

    function currentQuestion() {
      return questionBank.find((item) => item.id === state.currentQuestionId) || chooseQuestion();
    }

    function renderRoute() {
      const route = $("routeCells");
      route.innerHTML = "";
      for (let house = 0; house <= 30; house += 1) {
        const cell = document.createElement("span");
        cell.className = "route-cell";
        if (house <= state.position) cell.classList.add("passed");
        if (house === state.position) cell.classList.add("current");
        cell.title = `Casa ${house}`;
        route.appendChild(cell);
      }
      $("routePosition").textContent = `Casa ${state.position} de 30`;
    }

    function renderProgress() {
      $("positionValue").textContent = state.position;
      $("progressFill").style.width = `${(state.position / 30) * 100}%`;
      const activeTopic = topicIndexForPosition(state.position);
      document.querySelectorAll(".topic-flow div").forEach((node, index) => {
        node.classList.toggle("active", index === activeTopic);
        node.classList.toggle("done", index < activeTopic);
      });
      renderRoute();
    }

    function renderTurn() {
      $("turnName").textContent = `Jogador ${state.currentPlayer + 1}: ${state.players[state.currentPlayer]}`;
      $("playerName0").textContent = state.players[0];
      $("playerName1").textContent = state.players[1];
      $("playerRow0").classList.toggle("active", state.currentPlayer === 0);
      $("playerRow1").classList.toggle("active", state.currentPlayer === 1);
    }

    function renderQuestion() {
      const item = currentQuestion();
      $("roundCounter").textContent = `Rodada ${state.round}`;
      $("topicName").textContent = item.topic;
      $("questionText").textContent = item.q;
      $("feedback").className = "feedback hidden";
      $("rollBtn").classList.add("hidden");
      $("nextBtn").classList.add("hidden");
      const answers = $("answers");
      answers.innerHTML = "";
      answerOrderFor(item).forEach((originalIndex) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "answer";
        button.textContent = item.a[originalIndex];
        button.addEventListener("click", () => answerQuestion(originalIndex, button));
        answers.appendChild(button);
      });
      $("dice").className = "dice face-0";
      $("dice").setAttribute("aria-label", "Dado ainda não lançado");
      $("moveText").textContent = "Responda para movimentar a equipe";
      $("markText").textContent = `Posição atual: casa ${state.position}`;
      restoreSavedPhase(item);
      renderTurn();
      renderProgress();
    }

    function restoreSavedPhase(item) {
      if (state.phase === "question") return;
      const record = state.answersLog[state.answersLog.length - 1];
      if (!record || record.questionId !== item.id) {
        state.phase = "question";
        save();
        return;
      }

      disableAnswers();
      const feedback = $("feedback");
      feedback.classList.remove("hidden", "good", "bad");
      const answerButtons = [...document.querySelectorAll(".answer")];

      if (record.correct) {
        const correctDisplayIndex = answerOrderFor(item).indexOf(item.correct);
        answerButtons[correctDisplayIndex]?.classList.add("correct");
        feedback.classList.add("good");
        feedback.textContent = `Correto! ${item.note}`;
        if (state.phase === "readyRoll") {
          $("rollBtn").classList.remove("hidden");
          $("moveText").textContent = "Resposta correta: dado liberado";
          $("markText").textContent = "Gire o dado para descobrir o avanço";
          return;
        }
        const movement = Number(record.positionAfter) - Number(record.positionBefore);
        $("dice").className = `dice face-${record.roll}`;
        $("dice").setAttribute("aria-label", `Resultado do dado: ${record.roll}`);
        $("moveText").textContent = `Avance ${movement} ${movement === 1 ? "casa" : "casas"}`;
      } else {
        const selectedOriginalIndex = item.a.indexOf(record.selectedAnswer);
        const selectedDisplayIndex = answerOrderFor(item).indexOf(selectedOriginalIndex);
        answerButtons[selectedDisplayIndex]?.classList.add("wrong");
        const movement = Number(record.positionBefore) - Number(record.positionAfter);
        feedback.classList.add("bad");
        feedback.textContent = `Resposta incorreta. ${item.note} A equipe deve voltar ${movement} ${movement === 1 ? "casa" : "casas"}.`;
        $("moveText").textContent = movement ? `Volte ${movement} ${movement === 1 ? "casa" : "casas"}` : "Permaneça na casa 0";
      }

      $("markText").textContent = `Marque a casa ${state.position} no tabuleiro impresso`;
      $("nextBtn").textContent = state.position >= 30 ? "Concluir partida" : "Próxima rodada";
      $("nextBtn").classList.remove("hidden");
    }

    function disableAnswers() {
      document.querySelectorAll(".answer").forEach((answer) => { answer.disabled = true; });
    }

    function answerQuestion(answerIndex, button) {
      if (state.phase !== "question") return;
      const item = currentQuestion();
      const correct = answerIndex === item.correct;
      disableAnswers();
      const answerRecord = {
        round: state.round,
        playerNumber: state.currentPlayer + 1,
        player: state.players[state.currentPlayer],
        questionId: item.id,
        topic: item.topic,
        prompt: item.q,
        selectedAnswer: item.a[answerIndex],
        correctAnswer: item.a[item.correct],
        correct,
        positionBefore: state.position,
        recordedAt: new Date().toLocaleString("pt-BR")
      };
      state.answersLog.push(answerRecord);
      const feedback = $("feedback");
      feedback.classList.remove("hidden", "good", "bad");

      if (correct) {
        button.classList.add("correct");
        feedback.classList.add("good");
        feedback.textContent = `Correto! ${item.note}`;
        state.phase = "readyRoll";
        $("rollBtn").classList.remove("hidden");
        $("moveText").textContent = "Resposta correta: dado liberado";
        $("markText").textContent = "Gire o dado para descobrir o avanço";
        save();
        return;
      }

      button.classList.add("wrong");
      const oldPosition = state.position;
      const penalty = randomInt(1, 3);
      state.position = Math.max(0, state.position - penalty);
      const moved = oldPosition - state.position;
      answerRecord.penaltyDrawn = penalty;
      answerRecord.positionAfter = state.position;
      feedback.classList.add("bad");
      feedback.textContent = `Resposta incorreta. ${item.note} A equipe deve voltar ${moved} ${moved === 1 ? "casa" : "casas"}.`;
      state.history.push({
        round: state.round, player: state.players[state.currentPlayer], topic: item.topic,
        correct: false, movement: -moved, position: state.position
      });
      state.phase = "awaitNext";
      $("moveText").textContent = moved ? `Volte ${moved} ${moved === 1 ? "casa" : "casas"}` : "Permaneça na casa 0";
      $("markText").textContent = `Marque a casa ${state.position} no tabuleiro impresso`;
      $("nextBtn").classList.remove("hidden");
      renderProgress();
      renderHistory();
      save();
    }

    function rollDice() {
      if (state.phase !== "readyRoll") return;
      state.phase = "rolling";
      const dice = $("dice");
      const button = $("rollBtn");
      button.disabled = true;
      button.textContent = "Girando...";
      dice.classList.add("rolling");
      const animation = setInterval(() => {
        dice.className = `dice face-${randomInt(1, 3)} rolling`;
      }, 95);

      setTimeout(() => {
        clearInterval(animation);
        const roll = randomInt(1, 3);
        dice.className = `dice face-${roll}`;
        dice.setAttribute("aria-label", `Resultado do dado: ${roll}`);
        const oldPosition = state.position;
        state.position = Math.min(30, state.position + roll);
        const item = currentQuestion();
        const answerRecord = state.answersLog[state.answersLog.length - 1];
        answerRecord.roll = roll;
        answerRecord.positionAfter = state.position;
        state.history.push({
          round: state.round, player: state.players[state.currentPlayer], topic: item.topic,
          correct: true, movement: state.position - oldPosition, position: state.position
        });
        state.phase = "awaitNext";
        $("moveText").textContent = `Avance ${roll} ${roll === 1 ? "casa" : "casas"}`;
        $("markText").textContent = `Marque a casa ${state.position} no tabuleiro impresso`;
        button.classList.add("hidden");
        button.disabled = false;
        button.textContent = "Girar o dado";
        $("nextBtn").textContent = state.position >= 30 ? "Concluir partida" : "Próxima rodada";
        $("nextBtn").classList.remove("hidden");
        renderProgress();
        renderHistory();
        save();
      }, 1450);
    }

    function nextRound() {
      if (state.position >= 30) return finish();
      state.currentPlayer = state.currentPlayer === 0 ? 1 : 0;
      state.round += 1;
      state.currentQuestionId = null;
      state.answerOrder = null;
      chooseQuestion();
      renderQuestion();
    }

    function renderHistory() {
      const body = $("historyBody");
      if (!state.history.length) {
        body.innerHTML = '<tr class="empty-row"><td colspan="6">Nenhuma rodada registrada.</td></tr>';
        return;
      }
      body.innerHTML = state.history.map((item) => {
        const movement = item.movement > 0 ? `+${item.movement}` : String(item.movement);
        const resultClass = item.correct ? "result-good" : "result-bad";
        return `<tr><td>${item.round}</td><td>${escapeHtml(item.player)}</td><td>${escapeHtml(item.topic)}</td><td class="${resultClass}">${item.correct ? "Acertou" : "Errou"}</td><td>${movement}</td><td>Casa ${item.position}</td></tr>`;
      }).join("");
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" }[char]));
    }

    function showGame() {
      $("startScreen").classList.add("hidden");
      $("finishScreen").classList.add("hidden");
      $("gameScreen").classList.remove("hidden");
      $("exportBtn").classList.remove("hidden");
      $("teamDisplay").textContent = state.team;
      $("classDisplay").textContent = state.className || "Sem turma informada";
      if (!state.currentQuestionId) chooseQuestion();
      renderHistory();
      renderQuestion();
    }

    function finish() {
      state.finished = true;
      state.position = 30;
      save();
      $("gameScreen").classList.add("hidden");
      $("startScreen").classList.add("hidden");
      $("finishScreen").classList.remove("hidden");
      $("exportBtn").classList.add("hidden");
      const correct = state.history.filter((item) => item.correct).length;
      const wrong = state.history.length - correct;
      $("finishSummary").textContent = `${state.team}, formada por ${state.players[0]} e ${state.players[1]}, concluiu a revisão em ${state.history.length} rodadas: ${correct} respostas corretas e ${wrong} incorretas.`;
    }

    function exportResult() {
      const result = {
        atividade: "Corrida do Jest - Dupla em Teste",
        equipe: state.team,
        jogadores: state.players,
        turma: state.className || null,
        inicio: state.startedAt,
        exportadoEm: new Date().toISOString(),
        posicaoFinal: state.position,
        respostas: state.answersLog,
        rodadas: state.history
      };
      const safeName = state.team.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "").toLowerCase() || "equipe";
      const blob = new Blob([JSON.stringify(result, null, 2)], { type: "application/json" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `resultado-corrida-jest-${safeName}.json`;
      link.click();
      URL.revokeObjectURL(link.href);
    }

    function resetGame() {
      if (state.team && !confirm("Deseja apagar a partida atual e começar novamente?")) return;
      localStorage.removeItem(STORAGE_KEY);
      state = freshState();
      $("gameScreen").classList.add("hidden");
      $("finishScreen").classList.add("hidden");
      $("startScreen").classList.remove("hidden");
      $("exportBtn").classList.add("hidden");
      $("startForm").reset();
      $("teamName").focus();
    }

    $("startForm").addEventListener("submit", (event) => {
      event.preventDefault();
      state.team = $("teamName").value.trim();
      state.players = [$("player1").value.trim(), $("player2").value.trim()];
      state.className = $("className").value.trim();
      state.startedAt = new Date().toISOString();
      chooseQuestion();
      save();
      showGame();
    });
    $("rollBtn").addEventListener("click", rollDice);
    $("nextBtn").addEventListener("click", nextRound);
    $("exportBtn").addEventListener("click", exportResult);
    $("finishExportBtn").addEventListener("click", exportResult);
    $("resetBtn").addEventListener("click", resetGame);
    $("finishResetBtn").addEventListener("click", resetGame);

    load();
    if (state.finished) finish();
    else if (state.team) showGame();
  </script>
</body>
</html>
