<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Jogo cooperativo para revisar testes automatizados com Jest.">
  <title>Corrida do Jest - Dupla em Teste</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2317273f'/%3E%3Cpath d='M18 33l9 9 19-22' fill='none' stroke='%2337d2c2' stroke-width='8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <style>
    :root {
      --navy: #17273f;
      --navy-2: #243b5d;
      --ink: #203047;
      --muted: #64758c;
      --line: #d9e3ee;
      --paper: #f4f7fb;
      --white: #ffffff;
      --mint: #27b9aa;
      --mint-dark: #11897f;
      --mint-soft: #e6f8f5;
      --blue: #3478e5;
      --blue-soft: #eaf2ff;
      --orange: #f06a3f;
      --orange-soft: #fff0ea;
      --red: #d94b55;
      --red-soft: #fdecee;
      --green: #238c5d;
      --green-soft: #e8f6ef;
      --yellow: #f2b33d;
      --shadow: 0 18px 46px rgba(23, 39, 63, .11);
    }

    * { box-sizing: border-box; }
    html { color-scheme: light; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--ink);
      background:
        radial-gradient(circle at 8% 6%, rgba(39,185,170,.14), transparent 25rem),
        radial-gradient(circle at 95% 12%, rgba(240,106,63,.12), transparent 22rem),
        var(--paper);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    button, input { font: inherit; }
    button { cursor: pointer; }
    button:disabled { cursor: not-allowed; opacity: .68; }
    code { font-family: "Cascadia Code", Consolas, monospace; }
    .hidden { display: none !important; }

    .shell { width: min(1460px, calc(100% - 28px)); margin: 0 auto; padding: 22px 0 40px; }
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 18px;
      padding: 20px 24px;
      color: var(--white);
      border-radius: 24px;
      background: var(--navy);
      box-shadow: var(--shadow);
    }
    .topbar h1 { margin: 2px 0 0; font-size: clamp(1.55rem, 3vw, 2.25rem); letter-spacing: -.035em; }
    .eyebrow { margin: 0; color: var(--mint); font-size: .76rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
    .top-actions { display: flex; align-items: center; gap: 10px; }

    .primary, .secondary, .ghost {
      min-height: 46px;
      padding: 11px 18px;
      border-radius: 14px;
      border: 0;
      font-weight: 800;
      transition: transform .16s ease, box-shadow .16s ease, background .16s ease;
    }
    .primary { color: var(--white); background: var(--mint-dark); box-shadow: 0 8px 0 #0a625c; }
    .primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 0 #0a625c; }
    .secondary { color: var(--navy); background: var(--orange-soft); border: 1px solid #ffc8b7; }
    .ghost { color: var(--navy); background: var(--white); border: 1px solid var(--line); }
    .topbar .ghost { color: var(--white); background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.22); }

    .start-card, .finish-card {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: clamp(30px, 7vw, 86px);
      align-items: center;
      min-height: 620px;
      padding: clamp(30px, 6vw, 82px);
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: 28px;
      box-shadow: var(--shadow);
    }
    .start-copy h2, .finish-card h2 { margin: 12px 0 18px; font-size: clamp(2.2rem, 5vw, 4.7rem); line-height: .98; letter-spacing: -.055em; color: var(--navy); }
    .start-copy > p { max-width: 650px; margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.65; }
    .cooperation-note { margin-top: 28px; padding: 18px 20px; border-left: 5px solid var(--mint); border-radius: 14px; background: var(--mint-soft); line-height: 1.5; }
    .start-form { display: grid; gap: 10px; padding: 26px; border-radius: 22px; background: #f8fafc; border: 1px solid var(--line); }
    .start-form label { margin-top: 5px; color: var(--navy); font-size: .88rem; font-weight: 800; }
    .start-form label span { color: var(--muted); font-weight: 600; }
    .start-form input { width: 100%; min-height: 48px; padding: 11px 13px; color: var(--ink); background: var(--white); border: 1px solid #bdcad8; border-radius: 12px; outline: none; }
    .start-form input:focus { border-color: var(--mint-dark); box-shadow: 0 0 0 4px rgba(39,185,170,.14); }
    .start-form .primary { margin-top: 12px; }

    .game-grid {
      display: grid;
      grid-template-columns: minmax(230px, .72fr) minmax(520px, 1.65fr) minmax(240px, .76fr);
      gap: 16px;
      align-items: stretch;
    }
    .panel { background: var(--white); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); }
    .progress-card, .turn-card { padding: 22px; }
    .question-card { min-height: 600px; padding: clamp(24px, 4vw, 42px); }
    .history-card { grid-column: 1 / -1; padding: 22px; }

    .team-label { color: var(--muted); font-size: .75rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
    .team-name { display: block; margin: 4px 0 18px; color: var(--navy); font-size: 1.35rem; }
    .shared-chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border-radius: 999px; color: var(--mint-dark); background: var(--mint-soft); font-size: .78rem; font-weight: 850; }
    .shared-chip::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--mint); }

    .position-block { margin: 24px 0; padding: 18px; border-radius: 18px; background: var(--navy); color: var(--white); }
    .position-number { display: flex; align-items: baseline; gap: 5px; }
    .position-number strong { font-size: 3rem; line-height: 1; }
    .position-number span { color: #b9c8d8; font-weight: 800; }
    .position-block p { margin: 7px 0 13px; color: #cbd7e4; font-size: .82rem; }
    .progress-track { height: 9px; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.13); }
    .progress-track > div { width: 0; height: 100%; border-radius: inherit; background: var(--mint); transition: width .5s ease; }

    .topic-flow { display: grid; gap: 7px; }
    .topic-flow div { display: flex; align-items: center; gap: 9px; padding: 9px; border-radius: 11px; color: var(--muted); font-size: .8rem; font-weight: 750; }
    .topic-flow span { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 8px; background: #edf2f7; font-size: .68rem; }
    .topic-flow div.active { color: var(--navy); background: var(--orange-soft); }
    .topic-flow div.active span { color: var(--white); background: var(--orange); }
    .topic-flow div.done { color: var(--mint-dark); }
    .topic-flow div.done span { color: var(--white); background: var(--mint); }

    .route { margin-bottom: 28px; padding: 15px 16px; border-radius: 16px; background: #f8fafc; border: 1px solid var(--line); }
    .route-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 10px; color: var(--muted); font-size: .8rem; }
    .route-head strong { color: var(--navy); }
    .route-cells { display: grid; grid-template-columns: repeat(31, minmax(6px, 1fr)); gap: 3px; }
    .route-cell { aspect-ratio: 1; min-width: 5px; border-radius: 50%; background: #dce5ee; }
    .route-cell.passed { background: var(--mint); }
    .route-cell.current { outline: 3px solid rgba(240,106,63,.26); background: var(--orange); transform: scale(1.35); }

    .question-meta { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 22px; color: var(--muted); font-size: .86rem; font-weight: 800; }
    .question-meta span:last-child { color: var(--mint-dark); }
    .question-card h2 { margin: 0 0 26px; color: var(--navy); font-size: clamp(1.45rem, 3vw, 2.2rem); line-height: 1.2; white-space: pre-line; }
    .answers { display: grid; gap: 12px; }
    .answer { width: 100%; padding: 16px 18px; color: var(--ink); text-align: left; background: var(--white); border: 2px solid var(--line); border-radius: 15px; font-weight: 750; line-height: 1.4; }
    .answer:hover:not(:disabled) { border-color: var(--blue); background: var(--blue-soft); transform: translateX(3px); }
    .answer.correct { color: #146a47; border-color: var(--green); background: var(--green-soft); }
    .answer.wrong { color: #9e2832; border-color: var(--red); background: var(--red-soft); }
    .feedback { margin-top: 18px; padding: 16px 18px; border-radius: 14px; line-height: 1.5; font-weight: 700; }
    .feedback.good { color: #155f43; background: var(--green-soft); border-left: 5px solid var(--green); }
    .feedback.bad { color: #922934; background: var(--red-soft); border-left: 5px solid var(--red); }
    .question-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }

    .turn-banner { padding: 16px; border-radius: 16px; color: var(--white); background: linear-gradient(145deg, var(--blue), #2258b0); }
    .turn-banner p { margin: 0 0 5px; font-size: .73rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; opacity: .8; }
    .turn-banner strong { display: block; font-size: 1.35rem; line-height: 1.15; }
    .team-pair { display: grid; gap: 8px; margin: 14px 0 22px; }
    .player-row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 12px; color: var(--muted); background: #f4f7fa; font-size: .83rem; }
    .player-row.active { color: var(--navy); background: var(--orange-soft); outline: 2px solid #ffc9b8; }
    .player-row strong { color: inherit; }
    .last-move { padding-top: 18px; border-top: 1px solid var(--line); text-align: center; }
    .last-move > p { margin: 0 0 14px; color: var(--muted); font-size: .74rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
    .dice { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); place-items: center; width: 90px; height: 90px; margin: 0 auto 15px; padding: 13px; border: 3px solid var(--navy); border-radius: 21px; background: #f7fbff; box-shadow: 7px 8px 0 #c8e7dc; }
    .dice i { display: none; width: 13px; height: 13px; border-radius: 50%; background: var(--navy); }
    .dice i:nth-child(1) { grid-area: 1 / 1; }
    .dice i:nth-child(5) { grid-area: 2 / 2; }
    .dice i:nth-child(9) { grid-area: 3 / 3; }
    .dice.face-1 i:nth-child(5),
    .dice.face-2 i:nth-child(1), .dice.face-2 i:nth-child(9),
    .dice.face-3 i:nth-child(1), .dice.face-3 i:nth-child(5), .dice.face-3 i:nth-child(9) { display: block; }
    .dice.rolling { animation: shake .16s linear infinite alternate; }
    @keyframes shake { from { transform: rotate(-4deg) scale(.98); } to { transform: rotate(4deg) scale(1.03); } }
    #moveText { display: block; color: var(--navy); line-height: 1.35; }
    #markText { display: block; margin-top: 8px; color: var(--orange); font-size: .82rem; font-weight: 850; line-height: 1.35; }

    .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 14px; }
    .section-heading h2 { margin: 2px 0 0; color: var(--navy); }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 780px; }
    th, td { padding: 11px 10px; border-bottom: 1px solid var(--line); text-align: left; font-size: .79rem; }
    th { color: var(--muted); font-size: .7rem; letter-spacing: .06em; text-transform: uppercase; }
    .empty-row td { color: var(--muted); text-align: center; padding: 28px; }
    .result-good { color: var(--green); font-weight: 850; }
    .result-bad { color: var(--red); font-weight: 850; }

    .finish-card { grid-template-columns: 1fr; text-align: center; }
    .finish-card h2 { max-width: 900px; margin-inline: auto; }
    .finish-mark { display: grid; place-items: center; width: 82px; height: 82px; margin: 0 auto; border-radius: 24px; color: var(--white); background: var(--mint); font-size: 2.8rem; font-weight: 900; transform: rotate(-3deg); }
    .finish-card > p:not(.eyebrow) { max-width: 750px; margin: 0 auto; color: var(--muted); font-size: 1.08rem; line-height: 1.6; }
    .finish-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

    .screen-reader-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    @media (max-width: 1080px) {
      .game-grid { grid-template-columns: 1fr 1.5fr; }
      .turn-card { grid-column: 1; }
      .question-card { grid-column: 2; grid-row: 1 / span 2; }
      .history-card { grid-column: 1 / -1; }
    }
    @media (max-width: 760px) {
      .shell { width: min(100% - 16px, 720px); padding-top: 8px; }
      .topbar { align-items: flex-start; padding: 18px; }
      .top-actions { flex-direction: column; align-items: stretch; }
      .start-card { grid-template-columns: 1fr; min-height: 0; padding: 24px; }
      .game-grid { grid-template-columns: 1fr; }
      .progress-card, .turn-card, .question-card, .history-card { grid-column: 1; grid-row: auto; }
      .question-card { min-height: 0; }
      .route-cells { gap: 2px; }
      .question-actions { flex-direction: column; }
      .question-actions button { width: 100%; }
    }
    @media print {
      body { background: white; }
      .topbar, .progress-card, .turn-card, .question-card, .finish-card, .start-card { display: none !important; }
      .history-card { display: block !important; box-shadow: none; border: 0; }
      .shell { width: 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">REVISÃO COOPERATIVA</p>
        <h1>Corrida do Jest</h1>
      </div>
      <div class="top-actions">
        <button id="exportBtn" class="ghost hidden" type="button">Baixar resultado</button>
        <button id="resetBtn" class="ghost" type="button">Reiniciar</button>
      </div>
    </header>

    <section id="startScreen" class="start-card">
      <div class="start-copy">
        <p>Respondam em turnos e movimentem uma única peça. Depois de cada avanço ou recuo, marquem a nova posição no tabuleiro impresso.</p>
      </div>
      <form id="startForm" class="start-form">
        <label for="teamName">Nome da equipe</label>
        <input id="teamName" name="teamName" maxlength="40" autocomplete="off" placeholder="Ex.: Dupla Debug" required>
        <label for="player1">Nome do Jogador 1</label>
        <input id="player1" name="player1" maxlength="32" autocomplete="off" placeholder="Jogador 1" required>
        <label for="player2">Nome do Jogador 2</label>
        <input id="player2" name="player2" maxlength="32" autocomplete="off" placeholder="Jogador 2" required>
        <label for="className">Turma <span>(opcional)</span></label>
        <input id="className" name="className" maxlength="30" autocomplete="off" placeholder="Ex.: 3º ano A">
        <button class="primary" type="submit">Começar a revisão</button>
      </form>
    </section>

    <section id="gameScreen" class="game-grid hidden" aria-live="polite">
      <aside class="panel progress-card">
        <span class="team-label">Equipe</span>
        <strong id="teamDisplay" class="team-name"></strong>
        <span class="shared-chip">progresso compartilhado</span>

        <div class="position-block">
          <div class="position-number"><strong id="positionValue">0</strong><span>/ 30</span></div>
          <p>posição da equipe no tabuleiro</p>
          <div class="progress-track"><div id="progressFill"></div></div>
        </div>

        <div class="topic-flow" aria-label="Etapas da revisão">
          <div data-topic="0"><span>01</span>Preparação</div>
          <div data-topic="1"><span>02</span>Função JavaScript</div>
          <div data-topic="2"><span>03</span>Arquivo de teste</div>
          <div data-topic="3"><span>04</span>Executando</div>
          <div data-topic="4"><span>05</span>PASS e FAIL</div>
          <div data-topic="5"><span>06</span>Novos usos</div>
        </div>
      </aside>

      <section class="panel question-card">
        <div class="route">
          <div class="route-head"><strong>Caminho da equipe</strong><span id="routePosition">Casa 0 de 30</span></div>
          <div id="routeCells" class="route-cells" aria-label="Progresso da casa 0 até a casa 30"></div>
        </div>
        <div class="question-meta">
          <span id="roundCounter">Rodada 1</span>
          <span id="topicName">Preparação</span>
        </div>
        <h2 id="questionText"></h2>
        <div id="answers" class="answers"></div>
        <div id="feedback" class="feedback hidden"></div>
        <div class="question-actions">
          <button id="rollBtn" class="primary hidden" type="button">Girar o dado</button>
          <button id="nextBtn" class="primary hidden" type="button">Próxima rodada</button>
        </div>
      </section>

      <aside class="panel turn-card">
        <div class="turn-banner">
          <p>Agora responde</p>
          <strong id="turnName"></strong>
        </div>
        <div class="team-pair">
          <div id="playerRow0" class="player-row"><span>Jogador 1</span><strong id="playerName0"></strong></div>
          <div id="playerRow1" class="player-row"><span>Jogador 2</span><strong id="playerName1"></strong></div>
        </div>
        <div class="last-move">
          <p>Movimento da rodada</p>
          <div id="dice" class="dice face-0" aria-label="Dado ainda não lançado">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
          <strong id="moveText">Responda para movimentar a equipe</strong>
          <span id="markText">Posição inicial: casa 0</span>
        </div>
      </aside>

      <section class="panel history-card">
        <div class="section-heading">
          <div><p class="eyebrow">REGISTRO DA EQUIPE</p><h2>Histórico das rodadas</h2></div>
          <span id="classDisplay" class="shared-chip"></span>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Rodada</th><th>Jogador</th><th>Tema</th><th>Resultado</th><th>Movimento</th><th>Posição</th></tr></thead>
            <tbody id="historyBody"><tr class="empty-row"><td colspan="6">Nenhuma rodada registrada.</td></tr></tbody>
          </table>
        </div>
      </section>
    </section>

    <section id="finishScreen" class="finish-card hidden">
      <div class="finish-mark">✓</div>
      <p class="eyebrow">REVISÃO CONCLUÍDA</p>
      <h2>A equipe chegou à casa 30!</h2>
      <p id="finishSummary"></p>
      <div class="finish-actions">
        <button id="finishExportBtn" class="primary" type="button">Baixar resultado</button>
        <button id="finishResetBtn" class="ghost" type="button">Nova equipe</button>
      </div>
    </section>
  </main>

  <script>
    const questionBank = [
      { id: "E01", tier: "easy", topic: "Preparação", q: "Para que o Jest é usado em um projeto JavaScript?", a: ["Para automatizar testes", "Para desenhar a página", "Para criar o banco de dados"], correct: 0, note: "O Jest executa verificações automáticas no código JavaScript." },
      { id: "E02", tier: "easy", topic: "Preparação", q: "Qual comando instala o Jest como ferramenta de desenvolvimento?", a: ["npm install --save-dev jest", "npm start jest", "node install test"], correct: 0, note: "A opção --save-dev registra o Jest nas dependências de desenvolvimento." },
      { id: "E03", tier: "easy", topic: "Preparação", q: "No package.json, qual script permite executar os testes com npm test?", a: ['"test": "jest"', '"jest": "node"', '"start": "test"'], correct: 0, note: "O script test deve chamar o comando jest." },
      { id: "E04", tier: "easy", topic: "Função JavaScript", q: "Qual é o resultado de somar(2, 3) quando a função retorna a + b?", a: ["5", "6", "23"], correct: 0, note: "A função soma os dois números e retorna 5." },
      { id: "E05", tier: "easy", topic: "Função JavaScript", q: "O que module.exports = somar permite fazer?", a: ["Usar a função em outro arquivo", "Executar todos os testes", "Transformar número em texto"], correct: 0, note: "module.exports disponibiliza a função para ser importada pelo teste." },
      { id: "E06", tier: "easy", topic: "Arquivo de teste", q: "Qual nome segue o padrão usado pelo Jest para o teste da função somar?", a: ["soma.test.js", "soma.txt", "test.soma.html"], correct: 0, note: "Arquivos terminados em .test.js são encontrados pelo Jest." },
      { id: "E07", tier: "easy", topic: "Arquivo de teste", q: "O que test('descrição', () => { ... }) cria?", a: ["Um caso de teste", "Uma tabela HTML", "Uma variável global"], correct: 0, note: "test recebe uma descrição e a função que executa a verificação." },
      { id: "E08", tier: "easy", topic: "Arquivo de teste", q: "Em expect(somar(2, 3)).toBe(5), qual parte é o valor esperado?", a: ["5", "somar", "expect"], correct: 0, note: "toBe(5) informa o resultado exato esperado." },
      { id: "E09", tier: "easy", topic: "Arquivo de teste", q: "Como podemos ler expect(...) em linguagem simples?", a: ["Eu espero que...", "Eu instalo...", "Eu apago..."], correct: 0, note: "expect recebe o resultado real que queremos conferir." },
      { id: "E10", tier: "easy", topic: "Executando", q: "Qual comando executa todos os testes configurados no projeto?", a: ["npm test", "npm delete", "node html"], correct: 0, note: "npm test executa o script test do package.json." },
      { id: "E11", tier: "easy", topic: "PASS e FAIL", q: "O que PASS indica no resultado do Jest?", a: ["O resultado real correspondeu ao esperado", "O arquivo foi apagado", "O teste não foi executado"], correct: 0, note: "PASS indica que a verificação foi atendida." },
